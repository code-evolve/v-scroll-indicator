{
  "name": "v-scroll-indicator",
  "version": "1.0.0",
  "description": "A Vue 2 and Vue 3 component that shows indicators when scrollable content extends past the visible area.",
  "type": "module",
  "main": "dist/v-scroll-indicator.cjs",
  "module": "dist/v-scroll-indicator.mjs",
  "unpkg": "dist/v-scroll-indicator.umd.js",
  "jsdelivr": "dist/v-scroll-indicator.umd.js",
  "exports": {
    ".": {
      "import": "./dist/v-scroll-indicator.mjs",
      "require": "./dist/v-scroll-indicator.cjs"
    },
    "./umd": "./dist/v-scroll-indicator.umd.js",
    "./package.json": "./package.json"
  },
  "sideEffects": false,
  "scripts": {
    "build": "vite build && vite build --mode umd",
    "test": "npm run test:vue3 && npm run test:vue2",
    "test:vue3": "VUE_VERSION=3 vitest run",
    "test:vue2": "VUE_VERSION=2 vitest run"
  },
  "keywords": [
    "vue",
    "vuetify",
    "scroll",
    "scrolling",
    "more",
    "indicator",
    "arrow"
  ],
  "author": "Steven Spungin",
  "license": "MIT",
  "peerDependencies": {
    "vue": "^2.7.0 || ^3.0.0"
  },
  "dependencies": {
    "vue-demi": "^0.14.10"
  },
  "devDependencies": {
    "jsdom": "^26.1.0",
    "vite": "^7.3.7",
    "vitest": "^4.1.11",
    "vue": "^3.5.43",
    "vue2": "npm:vue@^2.7.16"
  }
}
